#!/usr/bin/env Rscript
library(rmarkdown)
#Esto es indispensable, pues ayuda a encontrar los archivos que se necesitan para automatizar todo el proceso
Sys.setenv(PATH = paste(
"/Applications/RStudio.app/Contents/Resources/app/quarto/bin/tools/aarch64",
"/usr/bin",
"/usr/local/bin",
"/opt/homebrew/bin",
Sys.getenv("PATH"),
sep = ":"
))
# 1. Definir la ruta de tu proyecto Git
dir_proyecto <- "/Users/miguelrosales/Documents/GitHub/Seguimiento-Proyecto-FAO" # Cambia por la ruta absoluta de tu carpeta de Git
setwd(dir_proyecto)
# 2. Renderizar el Flexdashboard a HTML
rmarkdown::render(
input = "index.Rmd",
output_file = "index.html" # Idealmente 'index.html' si usas GitHub Pages
)
# 3. Generar mensaje de commit dinámico con fecha y hora
mensaje_commit <- paste("Actualización automática dashboard -", format(Sys.time(), "%Y-%m-%d %H:%M"))
#system("git remote set-url origin https://github.com/MiguelRG98/Monitor-Tecnicos.git")
# 4. Comandos Git automáticos
system("git add .")
system(sprintf('git commit -m "%s"', mensaje_commit))
system("git push origin main")
