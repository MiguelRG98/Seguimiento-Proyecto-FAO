if (naux > 0) {
message("Hay personas sin género asignado")
} else {
message("Todo bien")
}
#Now, we are going to identify every institutio of which each person works----
df_clean$adscripcion <- ifelse(str_detect(df_clean$Institución, pattern = c("CADER|DDR|OREF")),
df_clean$Institución,
df_clean$Cargo)
df_clean <- df_clean |>
mutate(nivel = case_when(str_detect(adscripcion, "OREF") ~ "OREF",
str_detect(adscripcion, "DDR") ~ "DDR",
str_detect(adscripcion, "CADER|CENTRO DE APOYO AL DESARROLLO RURAL") ~ "CADER",
.default = "No identificado"))
#Clean duplicated names with a simple algorithm-----
df_clean.f <- tibble()
ents <- unique(df_clean$Estado)
i=1
#Un treshold alto únicamente permite identificar nombres con variaciones pequeñas
treshold = .89
#ent="SONORA"
#j=3
for(ent in ents){
df.i <- df_clean |>
filter(Estado==ent) |>
select(Nombre.completo, Estado) |>
mutate(flag="aux")
n <- nrow(df.i)
j=1
while(n > 0 & j <= nrow(df.i)){
name <- df.i$Nombre.completo[j]
idd.b <- stringsim(df.i$Nombre.completo[j], df.i$Nombre.completo[-j], method="jw") > treshold
idd.m <- which.max(stringsim(df.i$Nombre.completo[j], df.i$Nombre.completo[-j], method="jw"))
index <- ifelse(idd.b[idd.m], idd.m, NA)
if(is.na(index)){
j=j+1
n=n-1
} else {
df.i <- df.i |>
filter(Nombre.completo != name)
j=j+1
n=n-1
}
}
df_clean.f <- append(df_clean.f, list(df.i))
}
df.aux <- reduce(df_clean.f, rbind)
df_clean <- left_join(df_clean, df.aux, suffix = c("", ".x"))
df_clean <- df_clean |>
filter(!is.na(flag)) |>
select(-flag)
#Numeralia----
base_por_entidad <- df_clean |>
group_by(Estado, cve_ent) |>
summarise(Hombre = sum(sexo_h),
Mujer = sum(sexo_m)) #|>
#adorn_totals(where = "col") |>
#pivot_longer(cols = c(Hombre, Mujer), names_to = "Género") |>
#mutate(label = paste0(value, " (",round(100*value/Total), "%)"))
base_por_mes <- df_clean |>
group_by(mes) |>
summarise(Hombre = sum(sexo_h),
Mujer = sum(sexo_m)) |>
adorn_totals(where = "col") |>
pivot_longer(cols = c(Hombre, Mujer))
base_por_mes_area <- df_clean |>
group_by(mes, nivel) |>
summarise(Hombre = sum(sexo_h),
Mujer = sum(sexo_m)) |>
adorn_totals(where = "col") |>
pivot_longer(cols = c(Hombre, Mujer))
base_por_mes_entidad <- df_clean |>
group_by(Estado, cve_ent, mes) |>
summarise(Hombre = sum(sexo_h),
Mujer = sum(sexo_m)) |>
pivot_longer(cols = !c(mes, Estado), values_to = "n")
base_por_entidad_area <- df_clean |>
group_by(Estado, cve_ent, nivel) |>
summarise(Hombre = sum(sexo_h),
Mujer = sum(sexo_m)) |>
pivot_longer(cols = c(Hombre, Mujer))
