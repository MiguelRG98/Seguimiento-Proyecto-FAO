datos_encargados <- nueva %>%
mutate(
tecnico = ifelse(entidad %in% c("COLIMA", "QUINTANA ROO", "BAJA CALIFORNIA"), "Aldair Hernández e Iván Bravo", tecnico),
x2.x = ifelse(is.na(x2), x2.x, x2),
x2=ifelse(x2 %in% c("Presencial", "Virtual", "Reprogramada Virtual", "Reprogramada Presencial"), "En capacitación 🛄", ifelse(x2 %in% "Traslado / en transito", "Traslado / en transito", "Sin misión ⭕️")),
# Construimos el diseño HTML completo en letras grandes para cada entidad
tarjeta_html = paste0("<div style='font-family: sans-serif; padding: 5px 0px;'>",
"<div style='font-size: 15px; font-weight: 800; color: #1a252f; margin-bottom: 4px;'>",
"Encargado: <b>", tecnico, "</b>",
"</div>",
"<div style='font-size: 12px; color: #555555;'>",
"📍 ", entidad,
"</div>",
"<div style='font-size: 12px; color: #555555;'>",
"Situación: ", x2, "</div>",
"<div style='font-size: 12px; color: #555555;'>",
"Próxima capacitación: ", format(fecha, "%d de %B"), "</div>"
)
) |>
distinct(entidad, .keep_all = T)
# 2. Crear el objeto SharedData
base.m <- SharedData$new(datos_encargados, key = ~entidad, group = "estado_r")
View(datos_encargados)
