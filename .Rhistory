# Read libraries----
library(pacman)
p_load(here, tidyverse, data.table, janitor, ggplot2, openxlsx,
sf)
# AGRICULTURE----
## Read data base----
df <- fread(here("Bases", "Cierre_agricola_mun_2025.csv"),
encoding = "Latin-1")
View(df)
#Cultivos promedio por estado en DGSIAP----
cult_m <- df |> group_by(Idestado, Nomestado, Idddr, Nomddr, Idcader, Nomcader) |>
count()
View(cult_m)
View(df)
#Cultivos promedio por estado en DGSIAP----
cult_m <- df |> group_by(Idestado, Nomestado, Idddr, Nomddr, Idcader, Nomcader) |>
n_distinct(Nomcultivo)
#Cultivos promedio por estado en DGSIAP----
cult_m <- df |> group_by(Idestado, Nomestado, Idddr, Nomddr, Idcader, Nomcader) |>
summarise(n_cultivos = n_distinct(Nomcultivo))
View(cult_m)
unique(df$Nomcultivo)
test <- filter(df, Idcader=="Atlixco")
View(test)
test <- filter(df, Nomcader=="Atlixco")
View(test)
#Cultivos promedio por estado en DGSIAP----
cult_m <- df |> distinct(Idestado, Nomestado, Idddr, Nomddr, Idcader, Nomcader, Nomcultivo) |>
count()
#Cultivos promedio por estado en DGSIAP----
cult_m <- df |> distinct(Idestado, Nomestado, Idddr, Nomddr, Idcader, Nomcader, Nomcultivo) |>
n()
cult_m <- df |> distinct(Idestado, Nomestado, Idddr, Nomddr, Idcader, Nomcader, Nomcultivo)
View(cult_m)
#Cultivos promedio por estado en DGSIAP----
cult_m <- df |> distinct(Idestado, Nomestado, Idddr, Nomddr, Idcader, Nomcader, Nomcultivo) |>
group_by(Idestado, Nomestado, Idddr, Nomddr, Idcader, Nomcader) |>
n()
#Cultivos promedio por estado en DGSIAP----
cult_m <- df |> distinct(Idestado, Nomestado, Idddr, Nomddr, Idcader, Nomcader, Nomcultivo) |>
group_by(Idestado, Nomestado, Idddr, Nomddr, Idcader, Nomcader) |>
count()
View(cult_m)
View(test)
test <- filter(df, Nomcader=="Atlixco") |>
distinct(Nomcultivo, .keep_all = T)
View(test)
View(test)
test <- df |> filter(Nomcader=="Atlixco") |>
group_by(Idestado, Nomestado, Idddr, Nomddr, Idcader, Nomcader, Idmunicipio, Nommunicipio, Nomcicloproductivo, Nomunidad) |>
summarise(across(c(Sembrada, Cosechada, Siniestrada, Valorproduccion), \(x) sum(x, na.rm = T), .names = "SUMA_{.col}"))
View(test)
test <- df |> filter(Nomcader=="Atlixco") |>
group_by(Idestado, Nomestado, Idddr, Nomddr, Idcader, Nomcader, Idmunicipio, Nommunicipio, Nomcicloproductivo) |>
summarise(across(c(Sembrada, Cosechada, Siniestrada, Valorproduccion), \(x) sum(x, na.rm = T), .names = "SUMA_{.col}"))
View(test)
View(test)
a1 <- df |> filter(Nomcader=="Atlixco")
a2 <- left_join(a1, test)
View(a2)
a2$participacion <- a2$Sembrada/a2$SUMA_Sembrada
View(a2)
