entidad = case_when(name %in% c("alma_sinaloa", "x4") ~ "SINALOA",
name %in% c("ivan_edo_mex", "x6") ~ "MEXICO",
name %in% c("magdalena_guanajuato", "x8") ~ "GUANAJUATO",
name %in% c("jesus_guerrero", "x10") ~ "GUERRERO",
name %in% c("antonio_jalisco", "x12") ~ "JALISCO",
name %in% c("nayely_hidalgo", "x14") ~ "HIDALGO",
name %in% c("mario_oaxaca", "x16") ~ "OAXACA",
name %in% c("gustavo_veracruz", "x18") ~ "VERACRUZ",
name %in% c("brenda_durango", "x20") ~ "DURANGO",
name %in% c("homero_nuevo_leon", "x22") ~ "NUEVO LEON",
name %in% c("imelda_aguascalientes", "x24") ~ "AGUASCALIENTES",
name %in% c("irma_yucatan", "x26") ~ "YUCATAN",
name %in% c("jesus_sonora", "x28") ~ "SONORA",
name %in% c("juan_nayarit", "x30") ~ "NAYARIT",
name %in% c("laysa_chihuahua", "x32") ~ "CHIHUAHUA",
name %in% c("salvador_michoacan", "x34") ~ "MICHOACAN",
name %in% c("veronica_coahuila", "x36") ~ "COAHUILA",
name %in% c("gustavo_puebla", "x38") ~ "PUEBLA",
name %in% c("luis_cdmx", "x40") ~ "CIUDAD DE MEXICO",
name %in% c("luis_tlaxcala", "x42") ~ "TLAXCALA",
name %in% c("baja_california_sur_juan", "x44") ~ "BAJA CALIFORNIA SUR",
name %in% c("venancio_campeche", "x46") ~ "CAMPECHE",
name %in% c("chiapas_mahtza", "x48") ~ "CHIAPAS",
name %in% c("queretaro_daniel", "x50") ~ "QUERETARO",
name %in% c("san_luis_potosi_ricardo", "x52") ~ "SAN LUIS POTOSI",
name %in% c("tabasco_higinio", "x54") ~ "TABASCO",
name %in% c("tamaulipas_jaime", "x56") ~ "TAMAULIPAS",
name %in% c("zacatecas_martin", "x58") ~ "ZACATECAS",
name %in% c("colima_aldair", "x60") ~ "COLIMA",
name %in% c("morelos_ivan", "x62") ~ "MORELOS",
name %in% c("quintana_roo_aldair", "x64") ~ "QUINTANA ROO",
name %in% c("baja_california_aldair", "x66") ~ "BAJA CALIFORNIA"),
name = ifelse(str_detect(name, pattern = "[0-9]"), "Pecuario", "Agrícola"))
df.f <- df.f |>
pivot_longer(cols = Enero:Diciembre, values_to = "dinero") |>
mutate(dinero = as.numeric(dinero))
# Base auxiliar para generar las fechas del GANTT----
aux_fechas <- df.g |>
filter(mes %in% c("Día", "Técnico")) |>
select(mes:x169)
aux_fechas[3,] <- colnames(aux_fechas)
aux_fechas <- aux_fechas |>
pivot_longer(cols = !mes) |>
pivot_wider(names_from = mes, values_from = c(value)) |>
select(-name)
# Esto solo funciona porque en teoría, los días están bien y no se incluyen ni sábados ni domingos.
# ESTO PUEDE DAR ERROR: MODIFICAR ACÁ LAS FECHAS FINALES----
fechas <- seq.Date(from = as_date("2026-04-09"),
to = as_date("2027-12-31"),
by = 'day')
fechas <- fechas[!weekdays(fechas) %in% c("sábado", "domingo")]
aux_fechas$fecha <- fechas[1:nrow(aux_fechas)]
aux_fechas$verificar <- ifelse(day(aux_fechas$fecha) != as.numeric(aux_fechas$Técnico), 1, 0)
if(sum(aux_fechas$verificar) > 0){
message("ATENCIÓN: REVISAR LA PARTE DEL CÓDIGO DONDE SE GENERAN LAS FECHAS PARA EL GANTT")
}
#FINALMENTE revisamos que coincidan las fechas
prueba <- df.g |>
filter(!mes %in% c("Día", "Técnico")) |>
select(mes:x169) |>
pivot_longer(cols = abril:x169, values_to = "nota") |>
mutate(name.1= name,
aux = as.numeric(str_sub(name, start = 2)),
name = str_to_sentence(name),
name = case_when(aux %in% c(3:23) ~ "Abril",
aux %in% c(25:44) ~ "Mayo",
aux %in% c(46:66) ~ "Junio",
aux %in% c(68:89) ~ "Julio",
aux %in% c(91:110) ~ "Agosto",
aux %in% c(112:132) ~ "Septiembre",
aux %in% c(134:154) ~ "Octubre",
aux %in% c(156:169) ~ "Noviembre",
.default = name))
## Creamos una base auxiliar para ayudarnos a generar las notas del GANTT----
dict.gant <- read.xlsx(here("/Users/miguelrosales/Library/CloudStorage/OneDrive-FoodandAgricultureOrganization/Varios FAO/Planes de Capacitación Técnicos/Calendario GANTT - Misiones.xlsx"), sheet="Notación", colNames = FALSE) |>
clean_names() |>
mutate(x1=str_squish(x1))
df.g <- left_join(prueba, aux_fechas, join_by(name.1==mes)) |>
mutate(estado = str_extract(mes, "(?<=\\().+?(?=\\))"),
nota = toupper(str_squish(nota)))
df.g <- left_join(df.g, dict.gant, join_by(nota==x1))
df.g <- left_join(df.g, ent.tec, join_by(estado==entidad))
df.s <- df.s |>
select(entidad, btor_7, fecha_actualizacion, starts_with("estatus")) |>
mutate(across(starts_with("estatus"), \(x) as.character(x))) |>
pivot_longer(cols = starts_with("estatus")) |>
mutate(mes = case_when(name=="estatus" ~ "Abril",
str_detect(name, "2") ~ "Mayo",
str_detect(name, "3") ~ "Junio",
str_detect(name, "4") ~ "Julio",
str_detect(name, "5") ~ "Agosto",
str_detect(name, "6") ~ "Septiembre",
str_detect(name, "7") ~ "Octubre",
str_detect(name, "8") ~ "Noviembre",
str_detect(name, "9") ~ "Diciembre"),
fecha_actualizacion=as.Date(fecha_actualizacion, origin = "1899-12-30"))
# Generar etiqueta de acumulados----
df.p.acum <- df.p |> group_by(x2, name, tecnico, entidad) |>
summarise(value = sum(value)) |>
mutate(x1="Acumulado")
# Pegar a la base 'original'.
df.p <- rbind(df.p, df.p.acum)
b.2 <- df.g |>
filter(fecha==fecha_reciente) |>
filter(!is.na(nota)) |>
select(tecnico, x2, fecha) |>
mutate(fecha=format(fecha, "%d-%B-%Y")) |>
rename("Nombre"="tecnico", "Situación"="x2", "Fecha"="fecha")
if(nrow(b.2)==0){
b.2[1, "Nombre"] <- "Sin técnicos en capacitación"
b.2[1, "Situación"] <- "N.A"
b.2[1, "Fecha"] <- "N.A"
}
plot_ly(
type = 'table',
columnwidth = c(10,80,40, 60),
header = list(
values = c("ID", names(b.2)),
align = c('left', rep('center', ncol(b.2))),
line = list(width = 1, color = 'black'),
fill = list(color = 'darkblue'),
font = list(family = "Arial", size = 14, color = "white")
),
cells = list(
values = rbind(rownames(b.2),
t(as.matrix(unname(b.2))))
)
)
View(b.2)
b.2 <- df.g |>
filter(fecha==fecha_reciente) |>
filter(!is.na(nota)) |>
distinct(tecnico, x2, fecha) |>
mutate(fecha=format(fecha, "%d-%B-%Y")) |>
rename("Nombre"="tecnico", "Situación"="x2", "Fecha"="fecha")
if(nrow(b.2)==0){
b.2[1, "Nombre"] <- "Sin técnicos en capacitación"
b.2[1, "Situación"] <- "N.A"
b.2[1, "Fecha"] <- "N.A"
}
plot_ly(
type = 'table',
columnwidth = c(10,80,40, 60),
header = list(
values = c("ID", names(b.2)),
align = c('left', rep('center', ncol(b.2))),
line = list(width = 1, color = 'black'),
fill = list(color = 'darkblue'),
font = list(family = "Arial", size = 14, color = "white")
),
cells = list(
values = rbind(rownames(b.2),
t(as.matrix(unname(b.2))))
)
)
