"📍 ", entidad,
"</div>",
"<div style='font-size: 10px; color: #555555;'>",
"Situación: ", x2, "</div>",
"<div style='font-size: 10px; color: #555555;'>",
"Próxima capacitación: ", format(fecha, "%d de %B"), "</div>",
"<div style='font-size: 10px; color: #555555;'>", "Actualización: ", format(fecha_actualizacion, "%d de %B"), "</div>",
'<a href="', btor_7, '" target="_blank" style="color: #2980b9; font-weight: bold; text-decoration: underline; font-size:9px;">',
"Carpeta BTORs",
'</a>'
)
)
# 2. Crear el objeto SharedData
base.m <- SharedData$new(datos_encargados, key = ~entidad, group = "estado_r")
# 4. Renderizar como bloque único usando DT totalmente invisibilizado
datatable(
base.m,
height = "100%",
class = "compact cell-border",
selection = "none",
colnames = NULL,
escape = FALSE, # Permite interpretar las etiquetas HTML (div, b, etc.)
rownames = FALSE,
options = list(
dom = 't',
columnDefs = list(
list(targets = c(0,1,2,3,4,5,6), visible = FALSE) # Oculta la columna 'entidad' para que solo se vea 'tarjeta_html'
),
pageLength = 100,
ordering = FALSE,
initComplete = JS(
"function(settings, json) {",
# 1. Quitamos bordes y fondos
"  $(this.api().table().node()).css({'border': 'none', 'background': 'transparent', 'width': '100%'});",
"  $(this.api().table().body()).find('td').css({'border': 'none', 'padding': '0px'});",
# 2. CLAVE PARA EL HEIGHT: Forzamos al contenedor y al cuerpo a expandirse al 100% y permitir scroll si se requiere
"  $(this.api().table().container()).css({'height': '100%', 'width': '100%'});",
"  $('.dataTables_scrollBody').css({'max-height': 'none', 'height': '100%'});",
"}"
)
)
)
tags$script(HTML("
$(document).ready(function() {
setTimeout(function() {
// Reemplaza por la Entidad deseada (debe coincidir EXACTO con el texto de tu base)
var entidadDefault = 'AGUASCALIENTES';
var selectNode = $('#filtro_entidad select');
if (selectNode.length && selectNode[0].selectize) {
selectNode[0].selectize.setValue(entidadDefault);
}
}, 400); // Aumentamos a 400ms por seguridad
});
"))
datos_estatus <- df.s|>
mutate(value = toupper(value),
tarjeta_html = paste0("<div style='font-family: sans-serif; padding: 5px 0px;'>",
"<div style='font-size: 11px; font-weight: 800; color: #1a252f; margin-bottom: 4px;'>", toupper(mes), "<b>", ": </b>",
"<div style='font-size: 11px; font-weight: 800; color: #1a252f; margin-bottom: 4px;'>",
"Estatus: <b>", value,
"</div>",
"</div>"
)
)
bc.s <- SharedData$new(datos_estatus, key = ~entidad, group = "estado_r")
datatable(
bc.s,
class = "compact",
colnames = NULL,
escape = FALSE,      # 1. Fuerza a la tabla a ocupar todo el ancho posible
selection = "none",   # 2. DESACTIVA el clic/selección de filas en Crosstalk
rownames = FALSE,
options = list(
dom = 't',
paging = FALSE,
scrollY = "480px",
pageLength = 12,
ordering = FALSE,
columnDefs = list(
list(targets = c(0, 1, 2, 3, 4, 5), visible = FALSE) # Oculta columnas auxiliares
),
initComplete = JS(
"function(settings, json) {",
# Forzamos la tabla y las celdas a ocupar el 100% sin fondos ni bordes estorbosos
"  $(this.api().table().node()).css({'border': 'none', 'background': 'transparent', 'width': '90%'});",
"  $(this.api().table().body()).find('td').css({'border': 'none', 'padding': '0px'});",
"}"
)
)
)
b.1.e <- df.p |>
#filter(x1==mes_reciente) |>
group_by(name, entidad, x1) |>
summarise(total_capacitaciones = sum(value, na.rm = T), .groups = 'drop') |>
pivot_wider(names_from = name, values_from = total_capacitaciones) |>
mutate(
name = factor(x1, levels = c("Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre", "Acumulado")
))
b.1.ce <- SharedData$new(b.1.e, key = ~entidad, group = "estado_r")
# 2. Construir la dona con colores mapeados y texto al centro
b.1.ce |>
plot_ly(
x = ~name,
y = ~Planeadas,
type = "bar",
name = "Pendientes",
marker = list(color = 'gray')) |>
add_trace(y = ~Realizadas, name="Realizadas", marker = list(color = '#003A70')) |>
layout(xaxis = list(title=""), yaxis = list(title=""), barmode='group') |>
layout(
title = list(text = "Capacitaciones", font = list(size = 16)),
showlegend = TRUE,
clickmode="none"
) |>
highlight(on = NULL)
acum.generos.e <- df.listas |>
group_by(Estado) |>
summarise(Hombres = sum(sexo_h),
Mujeres = sum(sexo_m)) |>
mutate(mes="Acumulado")
generos.e <- df.listas |>
#filter(mes==mes_reciente) |>
group_by(Estado, mes) |>
summarise(Hombres = sum(sexo_h),
Mujeres = sum(sexo_m))
generos.e <- rbind(generos.e, acum.generos.e)
generos.e <- generos.e |>
mutate(
mes = factor(mes, levels = c("Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre", "Acumulado")
))
bc.3e <- SharedData$new(generos.e, key = ~Estado, group = "estado_r")
bc.3e |>
plot_ly(
x = ~mes,
y = ~Hombres,
type = "bar",
name = "Hombres",
marker = list(color = 'lightblue')) |>
add_trace(y = ~Mujeres, name="Mujeres", marker = list(color = 'darkblue')) |>
layout(xaxis = list(title=""), yaxis = list(title=""), barmode='group') |>
layout(
title = list(text = "Personas capacitadas", font = list(size = 16)),
showlegend = TRUE,
clickmode='none'
) |>
highlight(on = NULL)
rm(list = ls())
# Poner RStudio al español----
Sys.setlocale("LC_TIME", "es_ES.UTF-8")
fecha_reciente = Sys.Date()
# Cargar librerías----
library(pacman)
p_load(here, tidyverse, ggplot2, openxlsx, janitor, plotly, lubridate, hrbrthemes, echarts4r, crosstalk, DT, htmltools, scales, tidyxl, readxl)
#Leer bases de datos----
