sheetVisibility(wb)[1]
sheetVisibility(wb)
# Script to assign municipalities to technicians
rm(list = ls())
# Read libraries----
library(pacman)
p_load(here, tidyverse, data.table, janitor, ggplot2, openxlsx,
sf)
files <- list.files(here("CADERs por estado"))
for(i in 1:length(files)){
# 1. Create Workbook and Sheet
wb <- loadWorkbook(here("CADERs por estado", files[i]))
df <- read.xlsx(here("CADERs por estado", files[i]))
colnames(df) <- c("ID DDR", "DDR", "ID CADER", "CADER")
#Duplicated values.
df$Agrícola <- NA
df$Pecuario <- NA
#Pivot to make it longer
df <- df |> pivot_longer(cols = c(Agrícola, Pecuario), names_to = "Módulo") |>
select(!value)
df$`LB Criterio 1` <- NA
df$`LB Criterio 2` <- NA
df$`LB Criterio 3` <- NA
df$`LB Criterio 4` <- NA
df$`Meta Criterio 1` <- NA
df$`Meta Criterio 2` <- NA
df$`Meta Criterio 3` <- NA
df$`Meta Criterio 4` <- NA
df$Comentarios <-  NA
addWorksheet(wb = wb, sheetName = "Metas")
# Turn on grid lines
showGridLines(wb, "Metas", showGridLines = TRUE)
# 3. Write Data starting at row 3 (Leaving rows 1 & 2 for merged headers)
writeData(wb, "Metas", df, startRow = 3, colNames = FALSE)
# Write Header Row 2 text
headers_row2 <- c("ID DDR", "DDR", "ID CADER", "CADER", "Módulo",
"Criterio 1", "Criterio 2", "Criterio 3", "Criterio 4",
"Criterio 1", "Criterio 2", "Criterio 3", "Criterio 4",
"Comentarios")
writeData(wb, "Metas", as.data.frame(t(headers_row2)), startRow = 2, colNames = FALSE)
# Write Top Merged Headers (Row 1)
writeData(wb, "Metas", "LÍNEA BASE", startCol = 6, startRow = 1)
writeData(wb, "Metas", "META", startCol = 10, startRow = 1)
# 4. Merge Header Cells
# Top Level Headers
mergeCells(wb, "Metas", cols = 6:9, rows = 1)   # LÍNEA DE BASE
mergeCells(wb, "Metas", cols = 10:13, rows = 1) # META
n=nrow(df)+2
# 5. Define Styles
font_name <- "Calibri"
# Borders
thin_border <- createStyle(
border = "TopBottomLeftRight", borderStyle = "thin", borderColour = "black"
)
# Header Styles
style_top_lb <- createStyle(
fontName = font_name, fontSize = 11, textDecoration = "bold",
fgFill = "#2F3B4C", fontColour = "#FFFFFF", halign = "center", valign = "center"
)
style_top_meta <- createStyle(
fontName = font_name, fontSize = 11, textDecoration = "bold",
fgFill = "#1B4F72", fontColour = "#FFFFFF", halign = "center", valign = "center"
)
style_header_base <- createStyle(
fontName = font_name, fontSize = 10, textDecoration = "bold",
halign = "center", valign = "center", wrapText = TRUE
)
# Sub-header Fills (Criteria 1-4)
fill_c1 <- createStyle(fgFill = "#B0C4DE") # Grey/Blue
fill_c2 <- createStyle(fgFill = "#FCE4D6") # Light Blue FCE4D6
fill_c3 <- createStyle(fgFill = "#BDD7EE") # Peach
fill_c4 <- createStyle(fgFill = "#E2EFDA") # Light Green
# Data Styles
style_data_black <- createStyle(
fontName = font_name, fontSize = 10, halign = "center", valign = "center"
)
style_data_red <- createStyle(
fontName = font_name, fontSize = 10, fontColour = "#FF0000", textDecoration = "bold",
halign = "center", valign = "center"
)
style_comments <- createStyle(
fontName = font_name, fontSize = 9, halign = "left", valign = "center", wrapText = TRUE
)
# 6. Apply Styles & Formatting
# Apply Borders across the entire table region (Rows 1 to 6, Cols 1 to 14)
addStyle(wb, "Metas", thin_border, rows = 1:n, cols = 1:14, gridExpand = TRUE, stack = TRUE)
# Apply Top Header Styles
addStyle(wb, "Metas", style_top_lb, rows = 1, cols = 6:9, stack = TRUE)
addStyle(wb, "Metas", style_top_meta, rows = 1, cols = 10:13, stack = TRUE)
# Apply Row 2 Header Styles
addStyle(wb, "Metas", style_header_base, rows = 1:2, cols = 1:14, gridExpand = TRUE, stack = TRUE)
# Color Sub-headers
addStyle(wb, "Metas", fill_c1, rows = 2, cols = c(6, 10), stack = TRUE)
addStyle(wb, "Metas", fill_c2, rows = 2, cols = c(7, 11), stack = TRUE)
addStyle(wb, "Metas", fill_c3, rows = 2, cols = c(8, 12), stack = TRUE)
addStyle(wb, "Metas", fill_c4, rows = 2, cols = c(9, 13), stack = TRUE)
# Apply Data Row Styles
addStyle(wb, "Metas", style_data_black, rows = 3:n, cols = 1:9, gridExpand = TRUE, stack = TRUE)
addStyle(wb, "Metas", style_data_red, rows = 3:n, cols = 10:13, gridExpand = TRUE, stack = TRUE)
addStyle(wb, "Metas", style_comments, rows = 3:n, cols = 14, gridExpand = TRUE, stack = TRUE)
# 7. Set Row Heights and Column Widths
setRowHeights(wb, "Metas", rows = 1:2, heights = c(22, 22))
setRowHeights(wb, "Metas", rows = 3:n, heights = 25)
setColWidths(wb, "Metas", cols = 1:14, widths = c(10, 18, 10, 18, 12, 12, 12, 12, 12, 12, 12, 12, 12, 30))
sheetVisibility(wb)[1] <- FALSE
# 8. Save Workbook
saveWorkbook(wb, here("CADERs por estado_Styled", files[i]), overwrite = TRUE)
}
