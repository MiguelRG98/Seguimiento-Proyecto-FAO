df.p <- read.xlsx(here("/Users/miguelrosales/Library/CloudStorage/OneDrive-FoodandAgricultureOrganization/Varios FAO/Planes de Capacitación Técnicos/Resumen estadístico.xlsx"), sheet="Avance CAPACITACIONES",
startRow = 6, cols = 2:67) |>
clean_names() |>
filter(!is.na(x10) & x1 != "Total")
