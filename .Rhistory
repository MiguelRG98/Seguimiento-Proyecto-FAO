st_transform(crs = 4326) |>
mutate(cve_ent=as.numeric(CVE_ENT))
centros <- st_centroid(mapa.e)
base_por_entidad$X <- st_coordinates(centros)[unique(base_por_entidad$cve_ent),"X"]
base_por_entidad$Y <- st_coordinates(centros)[unique(base_por_entidad$cve_ent),"Y"]
base_por_entidad$Total <- base_por_entidad$Hombre+base_por_entidad$Mujer
mapa.e <- left_join(mapa.e, base_por_entidad)
