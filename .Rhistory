library(sf)
library(leaflet)
# Read shp of DDRs-----
ddrs.shp <- read_sf("/Users/miguelrosales/Library/CloudStorage/OneDrive-FoodandAgricultureOrganization/Scripts/Bases/shp/ddrs.shp")
ddrs.shp <- ddrs.shp |>
rename("entidad"="estado") |>
mutate(entidad = case_when(entidad=="MICHOACAN DE OCAMPO" ~ "MICHOACAN",
entidad== "VERACRUZ DE IGNACIO DE LA LLAVE" ~ "VERACRUZ",
entidad=="YUCATÁN" ~ "YUCATAN",
entidad=="COAHUILA DE ZARAGOZA"~ "COAHUILA",
.default= entidad)) |>
filter(!is.na(entidad))
#Read data of CADERS----
caders <- read_csv("/Users/miguelrosales/Library/CloudStorage/OneDrive-FoodandAgricultureOrganization/Scripts/Bases/base_cader_limpia.csv")
caders <- caders |>
rename("entidad"="estado") |>
distinct(entidad, id_estado, id_ddr, nombre_del_ddr, id_cader, nombre_del_cader_vs_cab, .keep_all = T)
sd_ddr <- SharedData$new(ddrs.shp, key = ~entidad, group = "estado_r")
sd_caders <- SharedData$new(caders, key = ~entidad, group = "estado_r")
