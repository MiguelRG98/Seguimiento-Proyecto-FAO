# (Asegúrate de guardar el script que pusiste arriba como un archivo .R, ej. "actualizar_dashboard.R")
ruta_script <- "/Users/miguelrosales/Desktop/Cosas FAO/Scripts importantes/Copia de Actualizar_Tablero_Tecnicos.R"
# 3. Crear el comando executable
cmd <- cron_rscript(ruta_script)
library(cronR)
#library(cronR)
# 2. Definir la ruta exacta a tu script .R
# (Asegúrate de guardar el script que pusiste arriba como un archivo .R, ej. "actualizar_dashboard.R")
ruta_script <- "/Users/miguelrosales/Desktop/Cosas FAO/Scripts importantes/Copia de Actualizar_Tablero_Tecnicos.R"
# 3. Crear el comando executable
cmd <- cron_rscript(ruta_script)
# 4. Programar para Lunes a Viernes a las 6:50 PM (18:50 hrs)
cron_add(
command     = cmd,
frequency   = '50 18 * * 1-5',  # Minuto 50, Hora 18, Lunes a Viernes (1-5)
id          = 'Monitor_Tecnicos_GitHub_vA',
description = 'Actualiza y sube el Flexdashboard a GitHub Pages'
)
cron_ls()
