# 2. Construir la dona con colores mapeados y texto al centro
acum.mes.pyr |>
plot_ly(
x = ~x1,
y = ~CADER,
type = "bar",
name = "CADER",
marker = list(color = '#a57f2c')) |>
add_trace(y = ~OREF, name="OREF", marker = list(color = '#003A70')) |>
add_trace(y = ~DDR, name="DDR", marker = list(color = '#611232')) |>
layout(xaxis = list(title=""), yaxis = list(title=""), barmode='group') |>
layout(
title = list(text = "Capacitaciones", font = list(size = 16)),
showlegend = TRUE,
clickmode="none"
) |>
highlight(on = NULL)
acum.mes.hm <- df.a |>
mutate(
x1 = factor(x1, levels = c("Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre", "Acumulado")
)) |>
group_by(x1, name) |>
summarise(por_mesinst = sum(value, na.rm = T), .groups = 'drop') |>
filter(x1 != "Acumulado") |>
pivot_wider(names_from = name, values_from = por_mesinst) |>
mutate(across(c(Hombres, Mujeres), \(x) cumsum(x)))
acum.mes.hm <-  acum.mes.hm |>
mutate(aux.n = as.numeric(x1)) |>
filter(aux.n <= numero)
