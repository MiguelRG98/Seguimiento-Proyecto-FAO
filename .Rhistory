#Loop to identify CADER Adscription----
dicc.df <- tibble()
## Loop to identify CADER Adscription----
caders <- read.xlsx("/Users/miguelrosales/Library/CloudStorage/OneDrive-FoodandAgricultureOrganization/Scripts/Bases/20072025 BASE DATOS 1.xlsx",
startRow = 10) |>
clean_names() |>
mutate(entidad_federativa = str_to_sentence(estado),
longitud=as.numeric(longitud),
entidad_federativa = case_when(entidad_federativa=="Michoacan de ocampo" ~ "Michoacán de Ocampo",
entidad_federativa=="San luis potosi" ~ "San Luis Potosí",
entidad_federativa=="Nuevo leon" ~ "Nuevo León",
entidad_federativa=="Baja california" ~ "Baja California",
entidad_federativa=="Quintana roo" ~ "Quintana Roo",
entidad_federativa=="Queretaro" ~ "Querétaro de Arteaga",
entidad_federativa=="Coahuila de zaragoza" ~ "Coahuila de Zaragoza",
entidad_federativa=="Mexico" ~ "México",
entidad_federativa=="Yucatan" ~ "Yucatán",
entidad_federativa=="Veracruz de ignacio de la llave" ~ "Veracruz de Ignacio de la Llave",
entidad_federativa=="Baja california sur" ~ "Baja California Sur",
entidad_federativa=="Ciudad de mexico" ~ "Ciudad de México",
entidad_federativa=="Quintana roo" ~ "Quintanta Roo",
.default = entidad_federativa
))
caders <- caders |>
distinct(estado, nombre_del_ddr, nombre_del_cader_vs_cab, longitud, latitud, entidad_federativa) |>
mutate(across(c(estado, nombre_del_cader_vs_cab), \(x) stri_trans_general(toupper(str_trim(x)), "latin-ascii")))
palabras_clave <- "CADER|DISTRITO|CENTRO DE APOYO AL DESARROLLO RURAL|DISTRITO DE DESARROLLO RURAL"
patron_regex <- str_glue("^(?:(?i)(?:{palabras_clave})\\s*\\d*|[^a-zA-ZÁ-ÿÑñ]*)[, .\\s]*(.*?)(?:\\b(?:DEL\\s+)?DDR\\b|\\bOREF\\b|[,.]|$)")
df_np <- df_clean |>
mutate(nom_cader = stri_trans_general(toupper(str_trim(adscripcion)), "latin-ascii"),
entidad_federativa = stri_trans_general(toupper(str_trim(Estado)), "latin-ascii")) |>
distinct(entidad_federativa, nom_cader) |>
#filter(lugar_de_trabajo=="CADER") |>
mutate(
# Intento A (el original basado en CADER)
intento_cader = str_match(
nom_cader,
"(?i)CADER\\s*\\d*\\s*(.*?)(?:\\b(?:DEL\\s+)?DDR\\b|\\bOREF\\b|[,.]|$)"
)[, 2],
intento_directo = str_match(nom_cader, patron_regex)[, 2],
# Validamos que tengan letras reales, si no, se hacen NA
intento_cader = if_else(str_detect(intento_cader, "^[^a-zA-ZÁ-ÿÑñ]*$"), NA_character_, intento_cader),
intento_directo = if_else(str_detect(intento_directo, "^[^a-zA-ZÁ-ÿÑñ]*$"), NA_character_, intento_directo),
# Fusionamos
extraido = coalesce(intento_cader, intento_directo),
# Limpieza extrema final
extraido = str_remove(extraido, "^[^a-zA-ZÁ-ÿÑñ]+"),
extraido = str_remove(extraido, "^(?i)[a-z]['’\\s]+\\s*"),
extraido = str_remove_all(extraido, "\\b\\d+\\b"),
extraido = str_squish(extraido),
# Si queda huérfana alguna palabra clave tras la limpieza, la hacemos NA
extraido = if_else(extraido == "" | is.na(extraido) | toupper(extraido) %in% c("CADER", "DISTRITO"), NA_character_, extraido)
) %>%
mutate(entidad_federativa = case_when(entidad_federativa=="COAHUILA" ~ "COAHUILA DE ZARAGOZA",
entidad_federativa=="MICHOACAN" ~ "MICHOACAN DE OCAMPO",
entidad_federativa=="VERACRUZ" ~ "VERACRUZ DE IGNACIO DE LA LLAVE",
.default = entidad_federativa)) |>
select(-intento_cader, -intento_directo)
## Main loop----
treshold = .70
entidades = unique(toupper(df_np$entidad_federativa))
i=1
dicc.df <- tibble()
for(entidad in entidades){
df.nc <- caders |> filter(estado==entidad)
df.np.i <- df_np |>
filter(entidad_federativa==entidad) |>
distinct(extraido, nom_cader)
for(j in 1:nrow(df.np.i)){
idd.b <- stringsim(df.np.i$extraido[j], df.nc$nombre_del_cader_vs_cab, method="jw") > treshold
idd.m <- which.max(stringsim(df.np.i$extraido[j], df.nc$nombre_del_cader_vs_cab, method="jw"))
index <- ifelse(idd.b[idd.m], idd.m, NA)
dicc.df[i, "adscripcion"] <- df.np.i$extraido[j]
dicc.df[i, "cader"] <- ifelse(is.na(index), NA, df.nc$nombre_del_cader_vs_cab[index])
dicc.df[i, "entidad"] <- entidad
dicc.df[i, "nom_cader"] <- df.np.i$nom_cader[j]
dicc.df[i, "latitud"] <- ifelse(is.na(index), NA, df.nc$latitud[index])
dicc.df[i, "longitud"] <- ifelse(is.na(index), NA, df.nc$longitud[index])
i=i+1
}
}
## Clean resulted data frame----
dicc.fn <-  dicc.df |>
distinct(cader, nom_cader, latitud, longitud, entidad) |>
filter(!is.na(cader))
ggplot()+
geom_sf(data = mapa.e, aes(fill=Total))+
geom_point(aes(x=longitud, y=latitud), data = dicc.fn)
# Save df of unique persons in folder----
write.xlsx(df_clean, "personas_unicas.xlsx", overwrite = T)
# This an attempt to contabilize the number of attended DDR.
n.ddrs <- left_join(caders, dicc.df, multiple = 'first')
ddr.atend <- n.ddrs |> group_by(estado, nombre_del_ddr) |>
summarise(atentidos = sum(!is.na(nom_cader))) |>
mutate(flag = ifelse(atentidos >=1,"Capacitado", NA), .keep = 'unused') |>
filter(flag=="Capacitado")
# Due to the strategy of capacitation is phisically based on DDRs (which grouping a number of CADERs)
# we assume that if a certain CADER was trained, in consequence all caders of the same ddr
# were trained.
# To complete our table we can use the diagnostic evaluation
url_fao_data <- "https://docs.google.com/spreadsheets/d/e/2PACX-1vSGcdqxColk_BnF7NgrgP6hzUnkFmA-rQfPE6ptC8FsLWPYzXoqq_2TCdnTj8Cm5l2POt0Lmf9YaXwW/pub?output=xlsx"
# 2. Descarga de datos en tiempo real
df <- read.xlsx(url_fao_data) |>
clean_names() |>
# Generar columnas auxiliares
mutate(treatment = ifelse(en_los_ultimos_seis_meses_ha_tomado_las_capacitaciones_sobre_estadistica_agricola_o_pecuaria_presencial_o_virtualmente == "No, no las he tomado", 0, 1),
modalidad = case_when(en_los_ultimos_seis_meses_ha_tomado_las_capacitaciones_sobre_estadistica_agricola_o_pecuaria_presencial_o_virtualmente == "No, no las he tomado" ~ "Sin capacitación",
en_los_ultimos_seis_meses_ha_tomado_las_capacitaciones_sobre_estadistica_agricola_o_pecuaria_presencial_o_virtualmente == "Sí, presencialmente" ~ "Presencialmente",
en_los_ultimos_seis_meses_ha_tomado_las_capacitaciones_sobre_estadistica_agricola_o_pecuaria_presencial_o_virtualmente == "Sí, virtualmente" ~ "Virtualmente",
en_los_ultimos_seis_meses_ha_tomado_las_capacitaciones_sobre_estadistica_agricola_o_pecuaria_presencial_o_virtualmente == "Sí, de las 2 formas" ~ "Híbrido"),
nombre_del_cader_ddr_u_oref_donde_labora =
str_trim(toupper(stri_trans_general(nombre_del_cader_ddr_u_oref_donde_labora, "latin-ascii"))))
palabras_clave <- "CADER|DISTRITO|CENTRO DE APOYO AL DESARROLLO RURAL|DISTRITO DE DESARROLLO RURAL"
patron_regex <- str_glue("^(?:(?i)(?:{palabras_clave})\\s*\\d*|[^a-zA-ZÁ-ÿÑñ]*)[, .\\s]*(.*?)(?:\\b(?:DEL\\s+)?DDR\\b|\\bOREF\\b|[,.]|$)")
df_np <- df |>
filter(modalidad %in% c("Presencialmente", "Híbrido")) |>
mutate(nom_cader = stri_trans_general(toupper(str_trim(nombre_del_cader_ddr_u_oref_donde_labora)), "latin-ascii"),
entidad_federativa = stri_trans_general(toupper(str_trim(entidad_federativa)), "latin-ascii")) |>
distinct(entidad_federativa, lugar_de_trabajo, nom_cader, email_address) |>
#filter(lugar_de_trabajo=="CADER") |>
mutate(
# Intento A (el original basado en CADER)
intento_cader = str_match(
nom_cader,
"(?i)CADER\\s*\\d*\\s*(.*?)(?:\\b(?:DEL\\s+)?DDR\\b|\\bOREF\\b|[,.]|$)"
)[, 2],
intento_directo = str_match(nom_cader, patron_regex)[, 2],
# Validamos que tengan letras reales, si no, se hacen NA
intento_cader = if_else(str_detect(intento_cader, "^[^a-zA-ZÁ-ÿÑñ]*$"), NA_character_, intento_cader),
intento_directo = if_else(str_detect(intento_directo, "^[^a-zA-ZÁ-ÿÑñ]*$"), NA_character_, intento_directo),
# Fusionamos
extraido = coalesce(intento_cader, intento_directo),
# Limpieza extrema final
extraido = str_remove(extraido, "^[^a-zA-ZÁ-ÿÑñ]+"),
extraido = str_remove(extraido, "^(?i)[a-z]['’\\s]+\\s*"),
extraido = str_remove_all(extraido, "\\b\\d+\\b"),
extraido = str_squish(extraido),
# Si queda huérfana alguna palabra clave tras la limpieza, la hacemos NA
extraido = if_else(extraido == "" | is.na(extraido) | toupper(extraido) %in% c("CADER", "DISTRITO"), NA_character_, extraido)
) %>%
# Modificar nombres de estados
mutate(entidad_federativa = case_when(entidad_federativa=="QUERETARO DE ARTEAGA" ~ "QUERETARO",
.default = entidad_federativa),
aux = ifelse(lugar_de_trabajo == "CADER" | str_detect(nom_cader, pattern = "CADER"),1,0)) |>
filter(aux==1) |>
select(-intento_cader, -intento_directo, -aux)
## Main loop----
treshold = .70
entidades = unique(toupper(df_np$entidad_federativa))
i=1
dicc.df <- tibble()
for(entidad in entidades){
df.nc <- caders |> filter(estado==entidad)
df.np.i <- df_np |>
filter(entidad_federativa==entidad, lugar_de_trabajo=="CADER", ) |>
distinct(extraido, nom_cader, email_address)
for(j in 1:nrow(df.np.i)){
idd.b <- stringsim(df.np.i$extraido[j], df.nc$nombre_del_cader_vs_cab, method="jw") > treshold
idd.m <- which.max(stringsim(df.np.i$extraido[j], df.nc$nombre_del_cader_vs_cab, method="jw"))
index <- ifelse(idd.b[idd.m], idd.m, NA)
dicc.df[i, "adscripcion"] <- df.np.i$extraido[j]
dicc.df[i, "cader"] <- ifelse(is.na(index), NA, df.nc$nombre_del_cader_vs_cab[index])
dicc.df[i, "entidad"] <- entidad
dicc.df[i, "email_address"] <- df.np.i$email_address[j]
dicc.df[i, "nom_cader"] <- df.np.i$nom_cader[j]
dicc.df[i, "latitud"] <- ifelse(is.na(index), NA, df.nc$latitud[index])
dicc.df[i, "longitud"] <- ifelse(is.na(index), NA, df.nc$longitud[index])
i=i+1
}
}
## Clean resulted data frame----
dicc.fn <-  dicc.df |>
distinct(entidad, cader) |>
filter(!is.na(cader)) |>
mutate(flag = "Capacitado")
# Generar una columna de nuevos estados para agregar la Región Lagunera.
#relacion <- dicc.fn |> distinct(cader, latitud, longitud, email_address)
adicionales <- left_join(caders, dicc.fn, join_by(estado==entidad, nombre_del_cader_vs_cab==cader))
adicionales <- adicionales |>
filter(!is.na(flag)) |>
distinct(estado, nombre_del_ddr, flag)
total_atendidos <- rbind(adicionales, ddr.atend) |>
filter(!is.na(estado)) |>
distinct(estado, nombre_del_ddr, flag)
# Final list of attenden CADERs----
base.final <-  left_join(caders, total_atendidos) |>
filter(!is.na(estado)) |>
mutate(flag = ifelse(is.na(flag), "No capacitado", flag)) |>
group_by(estado) |>
count(flag, name = "Total") |>
pivot_wider(names_from = flag, values_from = Total) |>
mutate(across(Capacitado:`No capacitado`, \(x) ifelse(is.na(x), 0,x)),
Total = rowSums(pick(c(Capacitado,`No capacitado`)), na.rm = T)) |>
adorn_totals(where = 'row')
# Asumming that if a CADER was trained the rest of caders of the same DDR were trained.
base.final.ddr <-  left_join(caders, total_atendidos) |>
filter(!is.na(estado)) |>
group_by(estado, nombre_del_ddr) |>
summarise(aux=sum(flag=="Capacitado")) |>
mutate(aux = ifelse(is.na(aux), "No capacitado", "Capacitado")) |>
group_by(estado) |>
count(aux, name = "Total") |>
pivot_wider(names_from = aux, values_from = Total) |>
mutate(across(Capacitado:`No capacitado`, \(x) ifelse(is.na(x), 0,x)),
Total = rowSums(pick(c(Capacitado,`No capacitado`)), na.rm = T)) |>
adorn_totals(where = 'row') |>
mutate(Avance = round(100*Capacitado/Total, 1))
